# Database
DATABASE_URL="postgresql://username:password@localhost:5432/drawx"

# Auth (apps/web)
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:4000"
GOOGLE_ID=""
GOOGLE_SECRET=""

# WebSocket tickets: the SAME value must be set for apps/web (signs) and apps/api (verifies).
# Generate with: openssl rand -base64 32
WS_TOKEN_SECRET=""

# apps/web: where the browser connects (use wss:// in production)
NEXT_PUBLIC_WS_URL="ws://localhost:3000"

# apps/api (optional): comma-separated list of Origins allowed to open a socket
ALLOWED_ORIGINS="http://localhost:4000"
